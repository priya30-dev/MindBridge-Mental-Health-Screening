# Hugging Face token (needed to download gated datasets)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Model paths
# 3-level risk model from train.py (preferred). Folder with config.json + model.safetensors
RISK_MODEL_DIR=./model
# Optional English-only model used for English check-ins when the main model is multilingual
RISK_MODEL_DIR_EN=./model_english
# 1 = English → English model, Hindi/Hinglish → multilingual model; 0 = main model for everything
LANGUAGE_ROUTING=1
# Old 6-emotion model, only used if RISK_MODEL_DIR has no model
TEXT_MODEL_PATH=./models/roberta_finetuned
AUDIO_MODEL_PATH=./models/audio_cnn.pt

# API settings
API_HOST=0.0.0.0
API_PORT=8000
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_in_production
# Comma-separated frontend URLs allowed to call the API
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Risk thresholds (0-100)
LOW_RISK_THRESHOLD=30
MED_RISK_THRESHOLD=60
HIGH_RISK_THRESHOLD=80
# Database (SQLite by default; use Postgres in production)
DATABASE_URL=sqlite:///./data/mindbridge.db
# DATABASE_URL=postgresql+psycopg2://mindbridge:mindbridge@db:5432/mindbridge

# Comma-separated emails that get the counsellor view when they sign up
COUNSELLOR_EMAILS=

# Login attempts allowed per IP per 5 minutes
AUTH_RATE_LIMIT=10

# Voice-only check-ins: transcribe speech with faster-whisper (pip install faster-whisper)
TRANSCRIBE=0
WHISPER_SIZE=base

# Dashboard -> API
API_BASE=http://localhost:8000/api/v1

# Speed: int8 quantization of the risk model (auto = on when running on CPU; 0 = off)
RISK_QUANTIZE=auto
# Speed: how many model runs the "which words mattered" explanation may use (lower = faster)
SHAP_MAX_EVALS=80
